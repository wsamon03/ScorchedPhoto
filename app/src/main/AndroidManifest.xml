<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Package-visibility (API 30+) declarations so DeathLineSpeaker's TextToSpeech can
         actually bind to the device's engine, and the setup screen's "install more voices"
         shortcut can resolve, without either silently failing. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" />
        </intent>
    </queries>

    <application
        android:name=".ScorchedPhotoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScorchedPhoto">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="user"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Temporary debug tooling: shows crashes on screen with a copy/share button
             instead of the system "App keeps stopping" dialog, for testing on a device
             with no computer/adb access. Runs in its own process so it survives even if
             the main process is being torn down by CrashHandler. -->
        <activity
            android:name=".crash.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.ScorchedPhoto" />
    </application>
</manifest>
